{
  "nmap_scan_mode": "stealth",
  "local_network_subnet_override": null,
  "nmap_arguments_custom": "-sS -sV -f -T1 -Pn --script=http-title,banner",
  "enable_brute_force": false,
  "brute_force_scripts": "",
  "brute_force_userdb": "users.txt",
  "brute_force_passdb": "pass.txt",
  "brute_force_stop_on_success": true,
  "nmap_scan_timeout_per_host": 600,
  "max_nmap_threads": 1,
  "log_file": "network_scanner_ultra_stealth.log",
  "log_level": "WARNING",
  "use_decoys": true,
  "decoy_count": 10,
  "fragment_packets": true,
  "randomize_hosts": true,
  "source_port": 53,
  "data_length": 25,
  "mtu_size": 24,
  "scan_delay": 1000,
  "max_rate": 10,
  "spoof_mac": null,
  "ttl_value": 64,
  "badsum": false,
  "scan_techniques": ["null", "fin", "xmas", "syn"],
  "ipv6_fallback": true,
  "proxy_chains": false,
  "retry_on_failure": true,
  "max_retries": 5,
  "adaptive_timing": true,
  "credentials": {
    "ssh": {
      "username": "",
      "password": "",
      "key_path": ""
    },
    "smb": {
      "username": "",
      "password": "",
      "domain": ""
    }
  },
  "external_db_urls": {
    "nvd_cve": "https://nvd.nist.gov/vuln/detail/",
    "exploitdb_search": "https://www.exploit-db.com/search?q="
  }
}
