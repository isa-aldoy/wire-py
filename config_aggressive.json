{
  "nmap_scan_mode": "aggressive",
  "local_network_subnet_override": null,
  "nmap_arguments_custom": "-sS -sV -A -T4 -Pn --script=vuln,http-enum,banner",
  "enable_brute_force": true,
  "brute_force_scripts": "ftp-brute,ssh-brute,telnet-brute,http-brute",
  "brute_force_userdb": "users.txt",
  "brute_force_passdb": "pass.txt",
  "brute_force_stop_on_success": true,
  "nmap_scan_timeout_per_host": 200,
  "max_nmap_threads": 5,
  "log_file": "network_scanner_aggressive.log",
  "log_level": "DEBUG",
  "use_decoys": false,
  "decoy_count": 0,
  "fragment_packets": false,
  "randomize_hosts": false,
  "source_port": 0,
  "data_length": 0,
  "mtu_size": 0,
  "scan_delay": 0,
  "max_rate": 0,
  "spoof_mac": null,
  "ttl_value": 0,
  "badsum": false,
  "scan_techniques": ["syn"],
  "ipv6_fallback": true,
  "proxy_chains": false,
  "retry_on_failure": true,
  "max_retries": 2,
  "adaptive_timing": false,
  "credentials": {
    "ssh": {
      "username": "",
      "password": "",
      "key_path": ""
    },
    "smb": {
      "username": "",
      "password": "",
      "domain": ""
    }
  },
  "external_db_urls": {
    "nvd_cve": "https://nvd.nist.gov/vuln/detail/",
    "exploitdb_search": "https://www.exploit-db.com/search?q="
  }
}
